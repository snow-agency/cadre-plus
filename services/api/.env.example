# Copier en .env (jamais commité) et renseigner la vraie clé.
# En production (Render), ces variables se saisissent dans le tableau de bord, pas dans un fichier.
RODIUM_API_KEY=rd_sk_prod_xxx
RODIUM_API_URL=https://api.rodiumai.io/v1
RODIUM_MODEL=anthropic/claude-sonnet-5

# Origines autorisées à appeler l'API (séparées par des virgules). Défaut : http://localhost:3000
# En production : l'adresse du site Vercel, ex. https://cadre-plus.vercel.app
CORS_ORIGINS=http://localhost:3000
# Optionnel : expression régulière pour autoriser les déploiements de prévisualisation Vercel
# CORS_ORIGIN_REGEX=https://cadre-plus-.*\.vercel\.app

# Plafonds d'appels à l'IA par heure (protège le crédit du fournisseur)
AI_RATE_LIMIT_PER_HOUR=30
AI_GLOBAL_LIMIT_PER_HOUR=300
