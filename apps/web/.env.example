# Adresse de l'API. En local : http://localhost:8001
# En production (Vercel) : l'adresse du service Render, ex. https://cadre-plus-api.onrender.com
# Attention : cette valeur est intégrée au site au moment du build ; il faut redéployer après l'avoir changée.
NEXT_PUBLIC_API_URL=http://localhost:8001

# Optionnel : style de carte MapLibre (URL). Défaut : fond OpenStreetMap intégré.
# NEXT_PUBLIC_MAP_STYLE_URL=
